# Orion 2.0
PORT=4000
DATABASE_URL=postgres://iagobastos@localhost:5432/orion2
# chave de 32+ chars para criptografar tokens da Meta (gere: openssl rand -hex 32)
APP_KEY=troque-esta-chave
JWT_SECRET=troque-este-segredo
# senha inicial do admin (usada só na primeira subida)
ADMIN_EMAIL=ferramentas@influencerslab.com.br
ADMIN_PASSWORD=troque123
# token que você define no painel da Meta ao configurar o webhook
META_VERIFY_TOKEN=orion-verify
# App Secret do app da Meta (valida assinatura X-Hub-Signature-256)
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
# token de segurança configurado na Kirvano (header security-token)
KIRVANO_TOKEN=
# URL pública (para links de mídia)
PUBLIC_URL=http://localhost:4000
UPLOAD_DIR=./uploads
